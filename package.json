{
	"name": "@summ/agent-flow-runtime",
	"version": "0.1.0",
	"description": "Portable Markdown Flow runtime and Pi extension",
	"keywords": [
		"pi-package",
		"agent",
		"flow",
		"workflow"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		}
	},
	"files": [
		"dist",
		"src",
		"docs",
		"skills",
		"README.md",
		"examples"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check . && tsc --noEmit",
		"format": "biome format --write .",
		"test": "npm run build && node --test test/runtime-smoke.mjs",
		"test:vitest": "vitest --run",
		"test:integration": "npm run build && node test/pi-sdk-smoke.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"dependencies": {
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		],
		"skills": [
			"./skills"
		]
	}
}
