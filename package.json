{
	"name": "@jhihjian/agent-flow-runtime",
	"version": "0.2.1",
	"description": "Portable Markdown Flow runtime and Pi extension",
	"keywords": [
		"pi-package",
		"agent",
		"flow",
		"workflow"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JhihJian/Agent-Flow-Runtime.git"
	},
	"bugs": {
		"url": "https://github.com/JhihJian/Agent-Flow-Runtime/issues"
	},
	"homepage": "https://github.com/JhihJian/Agent-Flow-Runtime#readme",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",

	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./pi": {
			"types": "./dist/pi/adapter.d.ts",
			"import": "./dist/pi/adapter.js"
		},
		"./extension": {
			"types": "./dist/pi/extension.d.ts",
			"import": "./dist/pi/extension.js"
		}
	},
	"files": [
		"dist",
		"src",
		"docs",
		"skills",
		"README.md",
		"examples",
		"ui"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check . && tsc --noEmit && npm run docs:source-index:check",
		"docs:source-index": "tsx tools/generate-source-index.ts --write",
		"docs:source-index:check": "tsx tools/generate-source-index.ts --check",
		"format": "biome format --write .",
		"test": "npm run docs:source-index:check && npm run build && node --import tsx --test test/runtime-smoke.mjs test/flow-package.test.ts test/source-index.test.ts test/correctness.test.ts test/extension-session-replacement.test.ts test/flow-reference.test.ts test/local-ui.test.ts && npm run test:vitest -- test/adapter-contract.test.ts test/parser.test.ts",
		"test:vitest": "vitest --run",
		"test:smoke": "vitest --run test/release-flow-smoke.test.ts test/release-flow-conflict.test.ts test/release-flow-recovery.test.ts test/profile-flow-smoke.test.ts",
		"test:release": "npm run check && npm run build && npm run test:smoke && npm test",
		"test:integration": "npm run build && node test/pi-sdk-smoke.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"dependencies": {
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "22.19.19",
		"ts-morph": "^27.0.2",
		"typebox": "1.3.27",
		"tsx": "^4.21.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/pi/extension.ts"
		],
		"skills": [
			"./skills"
		]
	}
}
